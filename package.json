{
  "name": "dsh-shortcuts",
  "version": "1.1.5",
  "description": "Fully customizable keyboard shortcuts for the DeepSeek Harness WebUI — macOS-first defaults, 34 pre-registered features across session/view/clipboard/model/permission/system groups, one-click recording to add your own bindings, silent permission cycling with color feedback.",
  "license": "MIT",
  "author": "ziqian.guo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ricketts-Guo/dsh-shortcuts.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "keyboard-shortcuts",
    "hotkeys",
    "web-ui",
    "productivity"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/compatibility.md"
  ],
  "scripts": {
    "test": "node test/shortcuts.test.cjs && node test/host.test.mjs && bash test/install.test.sh",
    "check": "node --check lib/client.js && node --check lib/index.js && npm test",
    "test:runtime": "node test/runtime.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": "0.1.5-rc.2 || 0.1.6-alpha.1 || 0.1.6-alpha.2",
      "node": ">=22.13.0",
      "profiles": [
        "web"
      ],
      "dshReleases": {
        "0.1.5-rc.2": "compatible",
        "0.1.6-alpha.1": "compatible",
        "0.1.6-alpha.2": "compatible"
      },
      "dshOperations": {
        "0.1.5-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        },
        "0.1.6-alpha.1": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        },
        "0.1.6-alpha.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "passed"
        }
      }
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "playwright": "1.58.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
